{
  "name": "tribal-knowledge-base-gui",
  "description": "Live Markdown knowledge graph and server-side curator activity viewer.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run --config ../../tests/knowledge_base_gui/vitest.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
