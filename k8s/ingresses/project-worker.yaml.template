apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: tribal-project-${PROJECT_ID}
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  rules:
    - http:
        paths:
          - path: /projects/${PROJECT_ID}
            pathType: Prefix
            backend:
              service:
                name: tribal-project-${PROJECT_ID}
                port:
                  number: 8000
          - path: /.well-known/oauth-authorization-server/projects/${PROJECT_ID}
            pathType: Prefix
            backend:
              service:
                name: tribal-project-${PROJECT_ID}
                port:
                  number: 8000
          - path: /.well-known/oauth-protected-resource/projects/${PROJECT_ID}/mcp
            pathType: Prefix
            backend:
              service:
                name: tribal-project-${PROJECT_ID}
                port:
                  number: 8000
