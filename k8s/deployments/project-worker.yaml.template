apiVersion: apps/v1
kind: Deployment
metadata:
  name: tribal-project-${PROJECT_ID}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: tribal-project-worker
      tribal.dev/project-id: "${PROJECT_ID}"
  template:
    metadata:
      labels:
        app.kubernetes.io/name: tribal-project-worker
        tribal.dev/project-id: "${PROJECT_ID}"
    spec:
      serviceAccountName: tribal-project-worker
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
      containers:
        - name: worker
          image: "${WORKER_IMAGE}"
          imagePullPolicy: Never
          command: ["python", "-m", "tribal"]
          args: ["worker"]
          envFrom:
            - configMapRef:
                name: tribal-project-${PROJECT_ID}
          env:
            - name: GITHUB_CLIENT_ID
              valueFrom:
                secretKeyRef:
                  name: tribal-github-oauth
                  key: GITHUB_CLIENT_ID
            - name: GITHUB_CLIENT_SECRET
              valueFrom:
                secretKeyRef:
                  name: tribal-github-oauth
                  key: GITHUB_CLIENT_SECRET
            - name: TOKEN_SIGNING_KEY
              valueFrom:
                secretKeyRef:
                  name: tribal-project-${PROJECT_ID}-auth
                  key: TOKEN_SIGNING_KEY
          ports:
            - name: http
              containerPort: 8000
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 5
            failureThreshold: 30
          readinessProbe:
            httpGet:
              path: /readyz
              port: http
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
