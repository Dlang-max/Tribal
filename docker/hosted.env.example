# Key-free inputs for the single-project hosted Compose stack.
TRIBAL_IMAGE=tribal-demo:replace-with-reviewed-build
TRIBAL_DOMAIN=tribal-ub-hacking-2026.duckdns.org
TRIBAL_STORAGE_ENV=../storage/app.env
# Generate the actual value outside Git, for example with secrets.token_urlsafe(32).
TRIBAL_MCP_BEARER_TOKEN=
# Optional model available to the server's authenticated Codex account.
TRIBAL_CODEX_MODEL=
